# Database
DATABASE_URL=postgresql://user:password@localhost:5432/conanp_dev
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/conanp_test

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Brevo (email transaccional)
BREVO_API_KEY=xkeysib-your-api-key
BREVO_SENDER_EMAIL=noreply@tudominio.com
BREVO_SENDER_NAME=CONANP

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=MXN

# AWS S3 (or Cloudflare R2)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=conanp-uploads
AWS_S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
AWS_S3_PUBLIC_URL=https://your-public-url.com

# Cache (Redis)
CACHE_ENABLED=true
REDIS_URL=redis://localhost:6379
CACHE_TTL_SUBSCRIPTION=600
CACHE_TTL_SUBSCRIPTION_PLAN=3600
CACHE_TTL_ACTIVIDAD=1800
CACHE_TTL_ORGANIZATION=1800
